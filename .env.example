# Copy to .env and fill in your keys. Never commit .env.
#
#   cp .env.example .env
#
# Only the provider named by STT_PROVIDER needs a key - SDK imports are lazy, so
# you can benchmark one provider without signing up for the other two.

# --- Provider selection -------------------------------------------------------
# Which speech-to-text provider the agent and benchmark use by default.
# One of: deepgram | whisper | assemblyai   (case-insensitive)
STT_PROVIDER=deepgram

# --- STT credentials (Sprint 1) -----------------------------------------------
# Deepgram nova-3 - the baseline. console.deepgram.com
DEEPGRAM_API_KEY=

# OpenAI whisper-1 - accuracy comparison. platform.openai.com/api-keys
OPENAI_API_KEY=

# AssemblyAI best tier - accuracy comparison. assemblyai.com/app/account
ASSEMBLYAI_API_KEY=
